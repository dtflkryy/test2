---------------------------------------------------------------------
-- LOGIC AIMBOT
---------------------------------------------------------------------
local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Exclude

local function getPart(char)
	local name = PARTS[S.TargetPart]
	if name == "Thân" then
		return char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso")
	end
	return char:FindFirstChild(name)
end

local function visible(part, char)
	rayParams.FilterDescendantsInstances = { LocalPlayer.Character, char, Camera }
	local origin = Camera.CFrame.Position
	local hit = Workspace:Raycast(origin, part.Position - origin, rayParams)
	return hit == nil
end

local function getTarget()
	local vp = Camera.ViewportSize
	local center = Vector2.new(vp.X / 2, vp.Y / 2)
	local best, bestDist = nil, S.FOV

	for _, plr in ipairs(Players:GetPlayers()) do
		if plr ~= LocalPlayer and plr.Character then
			if not (S.TeamCheck and plr.Team ~= nil and plr.Team == LocalPlayer.Team) then
				local char = plr.Character
				local hum = char:FindFirstChildOfClass("Humanoid")
				local part = getPart(char)
				if part and (not S.AliveCheck or (hum and hum.Health > 0)) then
					local worldPos = part.Position
					if S.Prediction > 0 then
						worldPos = worldPos + part.AssemblyLinearVelocity * S.Prediction
					end
					local sp, onScreen = Camera:WorldToViewportPoint(worldPos)
					if onScreen then
						local d = (Vector2.new(sp.X, sp.Y) - center).Magnitude
						local studs = (Camera.CFrame.Position - part.Position).Magnitude
						if d < bestDist and studs <= S.MaxDist
							and (not S.WallCheck or visible(part, char)) then
							bestDist = d
							best = worldPos
						end
					end
				end
			end
		end
	end
	return best
end

local conn = RunService.RenderStepped:Connect(function()
	Camera = Workspace.CurrentCamera
	local vp = Camera.ViewportSize

	fovFrame.Visible = S.ShowFOV
	fovFrame.Position = UDim2.fromOffset(vp.X / 2, vp.Y / 2)
	fovFrame.Size = UDim2.fromOffset(S.FOV * 2, S.FOV * 2)
	fovStroke.Color = S.Enabled and Color3.fromRGB(0, 255, 140) or Color3.new(1, 1, 1)

	if S.Enabled then
		local target = getTarget()
		if target then
			local cf = CFrame.new(Camera.CFrame.Position, target)
			Camera.CFrame = Camera.CFrame:Lerp(cf, S.Smooth)
		end
	end
end)
