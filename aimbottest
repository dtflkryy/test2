local function toggleRow(text, key)
	local b = Instance.new("TextButton")
	b.Size = UDim2.new(1, -4, 0, 30)
	b.BackgroundColor3 = Color3.fromRGB(44, 44, 56)
	b.Font = Enum.Font.Gotham
	b.TextSize = 13
	b.TextColor3 = Color3.new(1, 1, 1)
	b.Parent = list
	corner(b, 6)
	local function refresh()
		b.Text = text .. ": " .. (S[key] and "BẬT" or "TẮT")
		b.BackgroundColor3 = S[key] and Color3.fromRGB(0, 150, 95) or Color3.fromRGB(44, 44, 56)
	end
	refresh()
	b.Activated:Connect(function() S[key] = not S[key]; refresh() end)
end

local function stepRow(text, key, min, max, step, fmt)
	local f = Instance.new("Frame")
	f.Size = UDim2.new(1, -4, 0, 30)
	f.BackgroundColor3 = Color3.fromRGB(44, 44, 56)
	f.Parent = list
	corner(f, 6)

	local lbl = Instance.new("TextLabel")
	lbl.Size = UDim2.new(1, -70, 1, 0)
	lbl.Position = UDim2.fromOffset(8, 0)
	lbl.BackgroundTransparency = 1
	lbl.TextXAlignment = Enum.TextXAlignment.Left
	lbl.Font = Enum.Font.Gotham
	lbl.TextSize = 13
	lbl.TextColor3 = Color3.new(1, 1, 1)
	lbl.Parent = f

	local function refresh()
		lbl.Text = text .. ": " .. string.format(fmt or "%d", S[key])
	end
	refresh()

	local function btn(t, x, d)
		local b = Instance.new("TextButton")
		b.Size = UDim2.fromOffset(28, 22)
		b.Position = UDim2.new(1, x, 0.5, -11)
		b.BackgroundColor3 = Color3.fromRGB(70, 70, 90)
		b.Text = t
		b.Font = Enum.Font.GothamBold
		b.TextSize = 16
		b.TextColor3 = Color3.new(1, 1, 1)
		b.Parent = f
		corner(b, 5)
		b.Activated:Connect(function()
			S[key] = math.clamp(math.floor((S[key] + d * step) / step * 1000 + 0.5) / 1000 * step, min, max)
			refresh()
		end)
	end
	btn("-", -64, -1)
	btn("+", -34, 1)
end

local function cycleRow()
	local b = Instance.new("TextButton")
	b.Size = UDim2.new(1, -4, 0, 30)
	b.BackgroundColor3 = Color3.fromRGB(44, 44, 56)
	b.Font = Enum.Font.Gotham
	b.TextSize = 13
	b.TextColor3 = Color3.new(1, 1, 1)
	b.Parent = list
	corner(b, 6)
	local function refresh() b.Text = "Mục tiêu: " .. PARTS[S.TargetPart] end
	refresh()
	b.Activated:Connect(function()
		S.TargetPart = S.TargetPart % #PARTS + 1
		refresh()
	end)
end

