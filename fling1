local function getHRP() local c=lp.Character return c and c:FindFirstChild("HumanoidRootPart") end

local function match(n)
	n=n:lower()
	for _,k in ipairs(CFG.Keywords) do if n:find(k,1,true) then return true end end
	return false
end

local function mainPart(m)
	if m:IsA("BasePart") then return m end
	if not m:IsA("Model") then return end
	if m.PrimaryPart then return m.PrimaryPart end
	local best,bv=nil,-1
	for _,d in ipairs(m:GetDescendants()) do
		if d:IsA("BasePart") then
			local v=d.Size.X*d.Size.Y*d.Size.Z
			if v>bv then best,bv=d,v end
		end
	end
	return best
end

local function toyFolders()
	local r={}
	for _,c in ipairs(WS:GetChildren()) do
		if (c:IsA("Folder") or c:IsA("Model")) and c.Name:find(lp.Name,1,true) and c.Name:lower():find("toy") then r[#r+1]=c end
	end
	return r
end

local function scan()
	allToys={}
	local folders=toyFolders()
	for _,f in ipairs(folders) do
		for _,m in ipairs(f:GetChildren()) do
			local p=mainPart(m)
			if p then allToys[#allToys+1]={part=p,name=m.Name} end
		end
	end
	if #folders==0 then
		for _,d in ipairs(WS:GetDescendants()) do
			if (d:IsA("Model") or d:IsA("BasePart")) and match(d.Name) and not Players:GetPlayerFromCharacter(d)
				and (d.Parent==WS or not match(d.Parent.Name)) then
				local p=mainPart(d)
				if p and not p.Anchored then allToys[#allToys+1]={part=p,name=d.Name} end
			end
		end
	end
	for _,t in ipairs(allToys) do
		if selected[t.name]==nil and match(t.name) then selected[t.name]=true end
	end
	return #allToys
end

local function charOf(p)
	local m=p:FindFirstAncestorOfClass("Model")
	while m do
		if m:FindFirstChildOfClass("Humanoid") then return m end
		m=m.Parent and m.Parent:FindFirstAncestorOfClass("Model")
	end
end

local function heldParts()
	local res,seen={}, {}
	local function push(p,c)
		if p and p:IsA("BasePart") and not p.Anchored and not seen[p] and not (c and p:IsDescendantOf(c))
			and not (lp.Character and p:IsDescendantOf(lp.Character)) then
			seen[p]=true res[#res+1]=p
		end
	end
	for _,c in ipairs(WS:GetChildren()) do
		if (c:IsA("Model") or c:IsA("Folder") or c:IsA("BasePart")) and c.Name:lower():find("grab") then
			for _,d in ipairs(c:GetDescendants()) do
				if d:IsA("WeldConstraint") or d:IsA("Weld") then
					push(d.Part0,c) push(d.Part1,c)
				elseif d:IsA("Beam") or d:IsA("AlignPosition") or d:IsA("AlignOrientation") or d:IsA("RigidConstraint")
					or d:IsA("BallSocketConstraint") or d:IsA("RopeConstraint") then
					push(d.Attachment0 and d.Attachment0.Parent,c) push(d.Attachment1 and d.Attachment1.Parent,c)
				end
			end
		end
	end
	if #res==0 then
		for _,d in ipairs(WS:GetDescendants()) do
			if d:IsA("Beam") then
				local a,b=d.Attachment0 and d.Attachment0.Parent,d.Attachment1 and d.Attachment1.Parent
				if a and b and a:IsA("BasePart") and b:IsA("BasePart") then
					local ca,cb=charOf(a),charOf(b)
					if ca and not cb then push(b) elseif cb and not ca then push(a) end
				end
			end
		end
	end
	return res
end

local rayParams=RaycastParams.new()
rayParams.FilterType=Enum.RaycastFilterType.Exclude
local function getAim()
	cam=WS.CurrentCamera
	local ex={}
	if lp.Character then ex[1]=lp.Character end
	for _,f in ipairs(toyFolders()) do ex[#ex+1]=f end
	rayParams.FilterDescendantsInstances=ex
	local ray=cam:ViewportPointToRay(cam.ViewportSize.X/2,cam.ViewportSize.Y/2)
	local res=WS:Raycast(ray.Origin,ray.Direction*3000,rayParams)
	return res and res.Position or (ray.Origin+ray.Direction*600),ray.Direction.Unit
end

local function newGyro(part)
	local g=Instance.new("BodyGyro")
	g.MaxTorque=HUGE g.P=1e5 g.D=1e3 g.CFrame=part.CFrame g.Parent=part
	return g
end

local function clearBody(e)
	if e.bp then e.bp:Destroy() e.bp=nil end
	if e.bg then e.bg:Destroy() e.bg=nil end
end

local function addHover(part)
	if not part or not part.Parent or part.Anchored then return false end
	for _,h in ipairs(hovered) do if h.part==part then return false end end
	local bp=Instance.new("BodyPosition")
	bp.MaxForce=HUGE bp.P=1e5 bp.D=1e3 bp.Position=part.Position bp.Parent=part
	hovered[#hovered+1]={part=part,bp=bp,bg=newGyro(part)}
	return true
end

local function hoverAll()
	scan()
	local added=0
	for _,r in ipairs(allToys) do
		if selected[r.name] and addHover(r.part) then added+=1 end
	end
	status(#hovered==0 and "Chưa chọn toy nào." or ("Đang treo: "..#hovered.." (+"..added..")"))
end

local function hoverHeld()
	local added=0
	for _,p in ipairs(heldParts()) do if addHover(p) then added+=1 end end
	status(added>0 and ("Treo vật đang cầm: +"..added.." (tổng "..#hovered..")") or "Không thấy vật nào đang bị cầm")
end

local function releaseAll()
	for _,e in ipairs(hovered) do clearBody(e) end
	hovered={}
	status("Đã thả")
end

local spin=0
track(RS.Heartbeat:Connect(function(dt)
	local hrp,n=getHRP(),#hovered
	if not hrp or n==0 then return end
	spin+=dt*CFG.SpinSpeed
	local aimDir=WS.CurrentCamera.CFrame.LookVector
	for i=n,1,-1 do
		local e=hovered[i]
		if not e.part.Parent then
			table.remove(hovered,i)
		else
			local ring=(i-1)//CFG.PerRing
			local cnt=math.min(CFG.PerRing,n-ring*CFG.PerRing)
			local ang=spin+((i-1)%CFG.PerRing/cnt)*math.pi*2
			local rad=CFG.HoverRadius+ring*2
			local pos=hrp.Position+Vector3.new(math.cos(ang)*rad,CFG.HoverHeight+ring*3,math.sin(ang)*rad)
			if e.bp then e.bp.Position=pos end
			if e.bg then e.bg.CFrame=CFrame.lookAt(pos,pos+aimDir)*CFG.RocketOffset end
		end
	end
end))

local function launch(e,mode,aimPos,aimDir)
	local part=e.part
	if not part.Parent then return end
	if e.bp then e.bp:Destroy() e.bp=nil end
	e.bg=e.bg or newGyro(part)
	local bv=Instance.new("BodyVelocity")
	bv.MaxForce=HUGE bv.P=1e5 bv.Velocity=aimDir*CFG.Speed bv.Parent=part
	local target
	if mode=="carpet" then
		local a,r=math.random()*math.pi*2,math.sqrt(math.random())*CFG.CarpetRadius
		target=aimPos+Vector3.new(math.cos(a)*r,0,math.sin(a)*r)
	end
	local t0,c=os.clock()
	c=RS.Heartbeat:Connect(function()
		local done=(not part.Parent) or os.clock()-t0>CFG.FlyTime
		local dir=aimDir
		if not done and target then
			local d=target-part.Position
			if d.Magnitude<4 then done=true else dir=d.Unit end
		end
		if done then c:Disconnect() bv:Destroy() clearBody(e) return end
		bv.Velocity=dir*CFG.Speed
		if e.bg then e.bg.CFrame=CFrame.lookAt(part.Position,part.Position+dir)*CFG.RocketOffset end
	end)
end

local function fire(mode)
	if #hovered==0 then status("Chưa treo gì cả") return end
	local aimPos,aimDir=getAim()
	local list=hovered
	hovered={}
	for i,e in ipairs(list) do
		task.delay((i-1)*CFG.Stagger,function() launch(e,mode,aimPos,aimDir) end)
	end
	status((mode=="carpet" and "Bao trùm: " or "Khai hoả: ")..#list)
end

local drone={on=false,pos=Vector3.zero,yaw=0,pitch=0}
