pcall(function() controls=require(lp:WaitForChild("PlayerScripts"):WaitForChild("PlayerModule")):GetControls() end)

local function setDrone(on)
	if on==drone.on then return end
	drone.on=on
	droneGui.Enabled=on
	pcall(function()
		cam=WS.CurrentCamera
		if on then
			drone.pos=cam.CFrame.Position
			drone.pitch,drone.yaw=cam.CFrame:ToOrientation()
			cam.CameraType=Enum.CameraType.Scriptable
			if controls then controls:Disable() end
		else
			cam.CameraType=Enum.CameraType.Custom
			local h=lp.Character and lp.Character:FindFirstChildOfClass("Humanoid")
			if h then cam.CameraSubject=h end
			if controls then controls:Enable() end
			for k in pairs(held) do held[k]=false end
			UIS.MouseBehavior=Enum.MouseBehavior.Default
		end
	end)
	status(on and "Drone BẬT: W/A/S/D + kéo màn hình để xoay" or "Drone: TẮT")
end

RS:BindToRenderStep("FTAP_Drone",Enum.RenderPriority.Camera.Value+5,function(dt)
	if not drone.on then return end
	cam=WS.CurrentCamera
	cam.CameraType=Enum.CameraType.Scriptable
	local typing=UIS:GetFocusedTextBox()~=nil
	local function k(c,h) return (h or (not typing and UIS:IsKeyDown(c))) and 1 or 0 end
	local fwd=k(Enum.KeyCode.W,held.W)-k(Enum.KeyCode.S,held.S)
	local right=k(Enum.KeyCode.D,held.D)-k(Enum.KeyCode.A,held.A)
	local up=k(Enum.KeyCode.E,held.Up)-k(Enum.KeyCode.Q,held.Down)
	local rot=CFrame.fromOrientation(drone.pitch,drone.yaw,0)
	drone.pos+=(rot.LookVector*fwd+rot.RightVector*right+Vector3.yAxis*up)*CFG.DroneSpeed*dt
	cam.CFrame=CFrame.new(drone.pos)*rot
end)

local rmb,lookTouch=false,nil
local UT=Enum.UserInputType
track(UIS.InputBegan:Connect(function(i,gp)
	if not drone.on then return end
	if i.UserInputType==UT.MouseButton2 then
		rmb=true UIS.MouseBehavior=Enum.MouseBehavior.LockCurrentPosition
	elseif i.UserInputType==UT.Touch and not gp and not lookTouch then
		lookTouch=i
	end
end))
track(UIS.InputEnded:Connect(function(i)
	if i.UserInputType==UT.MouseButton2 then
		rmb=false UIS.MouseBehavior=Enum.MouseBehavior.Default
	elseif i==lookTouch then
		lookTouch=nil
	end
end))
track(UIS.InputChanged:Connect(function(i)
	if drone.on and ((i.UserInputType==UT.MouseMovement and rmb) or i==lookTouch) then
		drone.yaw-=i.Delta.X*CFG.LookSens
		drone.pitch=math.clamp(drone.pitch-i.Delta.Y*CFG.LookSens,-math.rad(89),math.rad(89))
	end
end))

