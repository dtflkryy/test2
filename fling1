local function newGui(name,order)
	local g=Instance.new("ScreenGui")
	g.Name=name g.ResetOnSpawn=false g.IgnoreGuiInset=true g.DisplayOrder=order
	g.ZIndexBehavior=Enum.ZIndexBehavior.Sibling
	pcall(function() g.ScreenInsets=Enum.ScreenInsets.None end)
	local ok,p=pcall(function() return (gethui and gethui()) or game:GetService("CoreGui") end)
	p=ok and p or lp:WaitForChild("PlayerGui")
	pcall(function() local o=p:FindFirstChild(name) if o then o:Destroy() end end)
	if not pcall(function() g.Parent=p end) then g.Parent=lp:WaitForChild("PlayerGui") end
	return g
end

