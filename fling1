local function makeDraggable(obj,handle,onTap)
	local drag,startPos,startVec,moved
	handle.Active=true
	handle.InputBegan:Connect(function(i)
		local t=i.UserInputType
		if (t==UT.MouseButton1 or t==UT.Touch) and not drag then
			drag,startPos,startVec,moved=i,obj.Position,i.Position,0
			i.Changed:Connect(function()
				if i.UserInputState==Enum.UserInputState.End and drag==i then
					drag=nil
					if moved<8 and onTap then onTap() end
				end
			end)
		end
	end)
	track(UIS.InputChanged:Connect(function(i)
		if not drag then return end
		if i==drag or (drag.UserInputType==UT.MouseButton1 and i.UserInputType==UT.MouseMovement) then
			local d=i.Position-startVec
			moved=math.max(moved,Vector2.new(d.X,d.Y).Magnitude)
			if locked then return end
			obj.Position=UDim2.new(startPos.X.Scale,startPos.X.Offset+d.X,startPos.Y.Scale,startPos.Y.Offset+d.Y)
		end
	end))
end

