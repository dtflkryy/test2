local function Swatches(page, text, list, cb)
    local f = row(page, 58)
    lbl(f, text, UDim2.fromOffset(10, 4), UDim2.new(1, -20, 0, 20))
    local holder = new("Frame", {BackgroundTransparency = 1, Position = UDim2.fromOffset(10, 28), Size = UDim2.new(1, -20, 0, 24)}, f)
    new("UIListLayout", {FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder}, holder)
    local strokes = {}
    for idx, c in ipairs(list) do
        local b = new("TextButton", {
            AutoButtonColor = false, Text = "", Size = UDim2.fromOffset(24, 24),
            BackgroundColor3 = c, BorderSizePixel = 0, LayoutOrder = idx,
        }, holder)
        corner(b, 12)
        local st = new("UIStroke", {Thickness = 2, Color = Color3.new(1, 1, 1), Transparency = idx == 1 and 0 or 1}, b)
        strokes[idx] = st
        b.Activated:Connect(function()
            for k, s in ipairs(strokes) do tw(s, 0.2, {Transparency = k == idx and 0 or 1}) end
            cb(c)
        end)
    end
end

local function Button(page, text, cb)
    local b = new("TextButton", {
        Size = UDim2.new(1, -6, 0, 34), AutoButtonColor = false, Text = text,
        Font = Enum.Font.GothamBold, TextSize = 13, BorderSizePixel = 0, LayoutOrder = nextOrder(page),
        TextColor3 = Color3.new(1, 1, 1),
    }, page)
    reg(b, "BackgroundColor3", "accent"); corner(b, 8); hover(b)
    b.Activated:Connect(cb)
    return b
end

