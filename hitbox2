        if k == name then
            p.Position = UDim2.fromOffset(8, 92)
            p.Visible = true
            tw(p, 0.25, {Position = UDim2.fromOffset(8, 82)}, Enum.EasingStyle.Quint)
        else
            p.Visible = false
        end
    end
    for k, b in pairs(tabs) do tw(b, 0.2, {BackgroundTransparency = k == name and 0 or 0.65}) end
end
