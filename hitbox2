local S = {
    Enabled     = false,
    Size        = 15,
    Transparency= 0.6,
    Part        = "HumanoidRootPart",
    Material    = Enum.Material.Neon,
    Color       = Color3.fromRGB(255, 60, 60),
    RainbowHB   = false,
    TeamCheck   = true,
    IgnoreDead  = true,
    Dist        = 1000,
    Particles   = true,
    Density     = 4,
}

local orig = setmetatable({}, {__mode = "k"})

local function restore(part)
    local o = orig[part]
    if o and part.Parent then
        pcall(function()
            part.Size = o.Size
            part.Transparency = o.Transparency
            part.Color = o.Color
            part.Material = o.Material
            part.CanCollide = o.CanCollide
        end)
    end
    orig[part] = nil
end

local function restoreAll()
    for part in pairs(orig) do restore(part) end
end

local function getPart(char)
    if S.Part == "Torso" then
        return char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso")
    end
    return char:FindFirstChild(S.Part)
end

bind(RunService.Heartbeat, function()
    if not S.Enabled then return end
    local col = S.RainbowHB and Color3.fromHSV(tick() % 4 / 4, 1, 1) or S.Color
    local sz = Vector3.new(S.Size, S.Size, S.Size)
    local myChar = LP.Character
    local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")

    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LP then
            local ch = p.Character
            local part = ch and getPart(ch)
            if part then
                local hum = ch:FindFirstChildOfClass("Humanoid")
                local skip = false
                if S.TeamCheck and p.Team ~= nil and p.Team == LP.Team then skip = true end
                if S.IgnoreDead and hum and hum.Health <= 0 then skip = true end
                if myRoot and (part.Position - myRoot.Position).Magnitude > S.Dist then skip = true end

                if skip then
                    restore(part)
                else
                    if not orig[part] then
                        orig[part] = {
                            Size = part.Size, Transparency = part.Transparency,
                            Color = part.Color, Material = part.Material,
                            CanCollide = part.CanCollide,
                        }
                    end
                    part.Size = sz
                    part.Transparency = S.Transparency
                    part.Color = col
                    part.Material = S.Material
                    part.CanCollide = false
                end
            end
        end
    end
end)

