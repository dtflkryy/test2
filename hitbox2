local current = "Dark"

local function C(role) return Themes[current][role] end
local function resolve(role) return type(role) == "function" and role() or C(role) end

local themed = {}
local function reg(inst, prop, role)
    table.insert(themed, {inst, prop, role})
    inst[prop] = resolve(role)
    return inst
end

local function applyTheme(name)
    current = name
    for _, t in ipairs(themed) do
        if t[1].Parent then tw(t[1], 0.35, {[t[2]] = resolve(t[3])}) end
    end
end

