local function row(page, h)
    local f = new("Frame", {Size = UDim2.new(1, -6, 0, h), BorderSizePixel = 0, LayoutOrder = nextOrder(page)}, page)
    reg(f, "BackgroundColor3", "bg2"); corner(f, 8)
    return f
end

local function lbl(parent, text, pos, size, xa)
    local l = new("TextLabel", {
        BackgroundTransparency = 1, Position = pos, Size = size, Text = text,
        Font = Enum.Font.GothamMedium, TextSize = 13, TextXAlignment = xa or Enum.TextXAlignment.Left,
    }, parent)
    reg(l, "TextColor3", "text")
    return l
end

local function hover(b)
    b.MouseEnter:Connect(function() tw(b, 0.15, {BackgroundTransparency = 0.2}) end)
    b.MouseLeave:Connect(function() tw(b, 0.15, {BackgroundTransparency = 0}) end)
end

local function Toggle(page, text, default, cb)
    local f = row(page, 36)
    lbl(f, text, UDim2.fromOffset(10, 0), UDim2.new(1, -70, 1, 0))
    local state = default
    local track = new("TextButton", {
        AutoButtonColor = false, Text = "", Size = UDim2.fromOffset(40, 20),
        Position = UDim2.new(1, -50, 0.5, -10), BorderSizePixel = 0,
    }, f)
    corner(track, 10)
    reg(track, "BackgroundColor3", function() return state and C("accent") or C("bg") end)
    local knob = new("Frame", {
        Size = UDim2.fromOffset(16, 16), BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0,
        Position = state and UDim2.fromOffset(22, 2) or UDim2.fromOffset(2, 2),
    }, track)
    corner(knob, 8)
    track.Activated:Connect(function()
        state = not state
        tw(knob, 0.2, {Position = state and UDim2.fromOffset(22, 2) or UDim2.fromOffset(2, 2)}, Enum.EasingStyle.Back)
        tw(track, 0.2, {BackgroundColor3 = state and C("accent") or C("bg")})
        cb(state)
    end)
end

local function Slider(page, text, min, max, default, dec, cb)
    local f = row(page, 50)
    lbl(f, text, UDim2.fromOffset(10, 4), UDim2.new(0.6, 0, 0, 20))
    local valLbl = lbl(f, tostring(default), UDim2.new(0.6, 0, 0, 4), UDim2.new(0.4, -10, 0, 20), Enum.TextXAlignment.Right)
    local bar = new("Frame", {Position = UDim2.new(0, 10, 0, 33), Size = UDim2.new(1, -20, 0, 6), BorderSizePixel = 0}, f)
    reg(bar, "BackgroundColor3", "bg"); corner(bar, 3)
    local a0 = (default - min) / (max - min)
    local fill = new("Frame", {Size = UDim2.new(a0, 0, 1, 0), BorderSizePixel = 0}, bar)
    reg(fill, "BackgroundColor3", "accent"); corner(fill, 3)
    local knob = new("Frame", {
        Size = UDim2.fromOffset(14, 14), Position = UDim2.new(1, -7, 0.5, -7),
        BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0,
    }, fill)
    corner(knob, 7)
    local hit = new("TextButton", {Text = "", BackgroundTransparency = 1, Position = UDim2.new(0, 0, 0, 22), Size = UDim2.new(1, 0, 0, 28)}, f)

    local dragging = false
    local function update(x)
        local a = math.clamp((x - bar.AbsolutePosition.X) / bar.AbsoluteSize.X, 0, 1)
        local m = 10 ^ dec
        local v = math.floor((min + (max - min) * a) * m + 0.5) / m
        tw(fill, 0.06, {Size = UDim2.new(a, 0, 1, 0)})
        valLbl.Text = tostring(v)
        cb(v)
    end
    local function isPtr(i) return i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch end
    hit.InputBegan:Connect(function(i)
        if isPtr(i) then
            dragging = true
            page.ScrollingEnabled = false
            tw(knob, 0.12, {Size = UDim2.fromOffset(18, 18), Position = UDim2.new(1, -9, 0.5, -9)})
            update(i.Position.X)
        end
    end)
    bind(UIS.InputChanged, function(i)
        if dragging and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
            update(i.Position.X)
        end
    end)
    bind(UIS.InputEnded, function(i)
        if dragging and isPtr(i) then
            dragging = false
            page.ScrollingEnabled = true
            tw(knob, 0.12, {Size = UDim2.fromOffset(14, 14), Position = UDim2.new(1, -7, 0.5, -7)})
        end
    end)
end

local function Choice(page, text, options, default, cb)
    local f = row(page, 58)
    lbl(f, text, UDim2.fromOffset(10, 4), UDim2.new(1, -20, 0, 20))
    local holder = new("Frame", {BackgroundTransparency = 1, Position = UDim2.fromOffset(10, 28), Size = UDim2.new(1, -20, 0, 24)}, f)
    new("UIListLayout", {FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 4), SortOrder = Enum.SortOrder.LayoutOrder}, holder)
    local sel = default
    local btns = {}
    for idx, opt in ipairs(options) do
        local b = new("TextButton", {
            AutoButtonColor = false, Size = UDim2.new(1 / #options, -4, 1, 0), Text = opt[1],
            Font = Enum.Font.GothamMedium, TextSize = 12, BorderSizePixel = 0, LayoutOrder = idx,
        }, holder)
        corner(b, 6)
        reg(b, "TextColor3", "text")
        reg(b, "BackgroundColor3", function() return sel == idx and C("accent") or C("bg") end)
        btns[idx] = b
        b.Activated:Connect(function()
            sel = idx
            for k, x in ipairs(btns) do tw(x, 0.2, {BackgroundColor3 = sel == k and C("accent") or C("bg")}) end
            cb(opt[2])
        end)
    end
end

