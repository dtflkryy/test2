	end)
end

local function getEnemies(name)
	local out = {}
	local folder = workspace:FindFirstChild("Enemies")
	if folder then
		for _, e in ipairs(folder:GetChildren()) do
			local h = e:FindFirstChildOfClass("Humanoid")
			local r = e:FindFirstChild("HumanoidRootPart")
			if h and r and h.Health > 0 and (not name or e.Name == name) then table.insert(out, e) end
		end
	end
	return out
end

local function nearestEnemy(name)
	local r = root()
	if not r then return end
	local best, bd
	for _, e in ipairs(getEnemies(name)) do
		local d = (e.HumanoidRootPart.Position - r.Position).Magnitude
		if not bd or d < bd then best, bd = e, d end
	end
	return best
end

local function findSpawn(name)
	local r = root()
	local wo = workspace:FindFirstChild("_WorldOrigin")
	local folder = wo and wo:FindFirstChild("EnemySpawns")
	if not (folder and r) then return end
	local best, bd
	for _, s in ipairs(folder:GetChildren()) do
		if s:IsA("BasePart") and string.find(s.Name, name, 1, true) then
			local d = (s.Position - r.Position).Magnitude
			if not bd or d < bd then best, bd = s, d end
		end
	end
	return best
end

local function bringMobs(name, cf)
	for _, e in ipairs(getEnemies(name)) do
		local r = e.HumanoidRootPart
		if (r.Position - cf.Position).Magnitude < 350 then
			r.CFrame = cf
			r.CanCollide = false
			e.Humanoid.WalkSpeed = 0
		end
	end
end

local function questForLevel()
	local ok, lv = pcall(function() return player.Data.Level.Value end)
	if not ok then return end
	local pick
	for _, q in ipairs(QUESTS) do if lv >= q[1] then pick = q end end
	return pick
end

local function questActive()
	local main = player.PlayerGui:FindFirstChild("Main")
	local q = main and main:FindFirstChild("Quest")
	return q and q.Visible
end

local function startQuest(q)
	pcall(function() RS.Remotes.CommF_:InvokeServer("StartQuest", q[2], q[3]) end)
end

