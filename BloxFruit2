local statusLbl
local function status(t) if statusLbl then statusLbl.Text = "Trạng thái: " .. t end end

local function root()
	local c = player.Character
	return c and c:FindFirstChild("HumanoidRootPart")
end
local function isAlive()
	local c = player.Character
	local h = c and c:FindFirstChildOfClass("Humanoid")
	return h and h.Health > 0
end

local activeTween
local function tweenTo(cf)
	local r = root()
	if not r then return end
	local dist = (r.Position - cf.Position).Magnitude
	if dist < 60 then r.CFrame = cf return end
	if activeTween then activeTween:Cancel() end
	activeTween = TweenService:Create(r, TweenInfo.new(dist / 250, Enum.EasingStyle.Linear), {CFrame = cf})
	activeTween:Play()
	activeTween.Completed:Wait()
end

local function holdOn(on)
	local r = root()
	if not r then return end
	local bv = r:FindFirstChild("XtremeHold")
	if on and not bv then
		bv = Instance.new("BodyVelocity")
		bv.Name = "XtremeHold"
		bv.MaxForce = Vector3.new(1e9, 1e9, 1e9)
		bv.Velocity = Vector3.zero
		bv.Parent = r
	elseif not on and bv then
		bv:Destroy()
	end
end

local function equipWeapon()
	local char = player.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if not hum then return end
	for _, t in ipairs(char:GetChildren()) do
		if t:IsA("Tool") and t.ToolTip == S.weaponType then return end
	end
	for _, t in ipairs(player.Backpack:GetChildren()) do
		if t:IsA("Tool") and t.ToolTip == S.weaponType then hum:EquipTool(t) return end
	end
end

local function click()
	pcall(function()
		VirtualUser:CaptureController()
