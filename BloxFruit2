local function farming() return S.autoLevel or S.autoMob end

-- Auto farm
task.spawn(function()
	local wasFarming = false
	while alive do
		task.wait(0.1)
		local f = farming()
		if f and isAlive() then
			wasFarming = true
			holdOn(true)
			pcall(function()
				local mobName
				if S.autoLevel and sea == 1 then
					local q = questForLevel()
					if q then
						mobName = q[4]
						if not questActive() then
							status("Nhận quest " .. q[2])
							startQuest(q)
							task.wait(0.6)
						end
					end
				else
					mobName = S.mob
					if S.autoLevel then status("Auto Level chỉ hỗ trợ Sea 1, hãy chọn quái thủ công") end
				end
				if not mobName then
					status("Chưa có quái để farm")
					return
				end
				equipWeapon()
				local e = nearestEnemy(mobName)
				if not e then
					local sp = findSpawn(mobName)
					if sp then
						status("Đi tới chỗ " .. mobName)
						tweenTo(sp.CFrame * CFrame.new(0, 15, 0))
					else
						status("Không thấy " .. mobName)
					end
					task.wait(0.5)
					return
				end
				status("Đang đánh " .. mobName)
				local er = e:FindFirstChild("HumanoidRootPart")
				if er then tweenTo(er.CFrame * CFrame.new(0, 12, 0)) end
				local hum = e:FindFirstChildOfClass("Humanoid")
				while alive and farming() and isAlive() and hum and hum.Health > 0 and e.Parent do
					local r, er2 = root(), e:FindFirstChild("HumanoidRootPart")
					if not (r and er2) then break end
					if S.bring then bringMobs(mobName, er2.CFrame) end
					r.CFrame = er2.CFrame * CFrame.new(0, 12, 0) * CFrame.Angles(math.rad(-90), 0, 0)
					equipWeapon()
					click()
					task.wait(0.1)
				end
			end)
		elseif wasFarming then
			wasFarming = false
			holdOn(false)
			if activeTween then activeTween:Cancel() end
			status("chờ lệnh")
		end
	end
end)

