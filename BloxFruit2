local renders = {}
local function toggle(page, text, key, onChange)
	local b = new("TextButton", {
		Size = UDim2.new(1, -4, 0, 34), BackgroundColor3 = PANEL, Text = "", BorderSizePixel = 0, LayoutOrder = ord(page),
	}, page)
	round(b, 6)
	new("TextLabel", {
		Size = UDim2.new(1, -60, 1, 0), Position = UDim2.fromOffset(10, 0), BackgroundTransparency = 1, Text = text,
		TextSize = 13, Font = Enum.Font.GothamBold, TextColor3 = WHITE, TextXAlignment = Enum.TextXAlignment.Left,
	}, b)
	local ind = new("TextLabel", {
		Size = UDim2.fromOffset(44, 22), Position = UDim2.new(1, -52, 0.5, -11), BackgroundColor3 = OFFC,
		Text = "OFF", TextSize = 11, Font = Enum.Font.GothamBold, TextColor3 = WHITE, BorderSizePixel = 0,
	}, b)
	round(ind, 11)
	local function render()
		ind.Text = S[key] and "ON" or "OFF"
		ind.BackgroundColor3 = S[key] and ACCENT or OFFC
	end
	renders[key] = render
	track(b.Activated:Connect(function()
		S[key] = not S[key]
		if onChange then onChange(S[key]) end
		for _, r in pairs(renders) do r() end
	end))
	render()
end

local function button(page, text, cb)
	local b = new("TextButton", {
		Size = UDim2.new(1, -4, 0, 34), BackgroundColor3 = PANEL, Text = text, TextSize = 13,
		Font = Enum.Font.GothamBold, TextColor3 = WHITE, BorderSizePixel = 0, LayoutOrder = ord(page),
	}, page)
	round(b, 6)
	track(b.Activated:Connect(function() cb(b) end))
	return b
end

local function cycle(page, text, options, key)
	local i = table.find(options, S[key]) or 1
	button(page, text .. ": " .. S[key], function(b)
		i = i % #options + 1
		S[key] = options[i]
		b.Text = text .. ": " .. S[key]
	end)
end

local function inputRow(page, text, default, onSet)
	local f = new("Frame", {Size = UDim2.new(1, -4, 0, 34), BackgroundColor3 = PANEL, BorderSizePixel = 0, LayoutOrder = ord(page)}, page)
