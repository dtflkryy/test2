local lp = Players.LocalPlayer
if not game:IsLoaded() then game.Loaded:Wait() end

if getgenv then
	if getgenv().XTREME_LOADED then
		warn("XTREME đã chạy rồi, bỏ qua.")
		return
	end
	getgenv().XTREME_LOADED = true
end

local cfg = {
	Farm = false,
	Click = false,
	Haki = false,
	Height = 12,   -- độ cao lơ lửng trên đầu quái
	Range = 3000,  -- tầm tìm quái
	Speed = 250,   -- tốc độ bay (studs/giây)
}

---------------------------------------------------------------- helpers
local function getHRP()
	local c = lp.Character
	return c and c:FindFirstChild("HumanoidRootPart")
end

local function nearestEnemy()
	local root = getHRP()
	local folder = workspace:FindFirstChild("Enemies")
	if not root or not folder then return end
	local best, bestDist = nil, cfg.Range
	for _, m in ipairs(folder:GetChildren()) do
		local hum = m:FindFirstChildOfClass("Humanoid")
		local part = m:FindFirstChild("HumanoidRootPart")
		if hum and part and hum.Health > 0 then
			local d = (part.Position - root.Position).Magnitude
			if d < bestDist then
				best, bestDist = m, d
			end
		end
	end
	return best
end

local function equipMelee()
	local c = lp.Character
	if not c or c:FindFirstChildOfClass("Tool") then return end
	local hum = c:FindFirstChildOfClass("Humanoid")
	if not hum then return end
	for _, t in ipairs(lp.Backpack:GetChildren()) do
		if t:IsA("Tool") and t.ToolTip == "Melee" then
			hum:EquipTool(t)
			return
		end
	end
end

local currentTween
local function flyTo(cf)
	local root = getHRP()
	if not root then return end
	local dist = (root.Position - cf.Position).Magnitude
	if dist < 15 then
		root.CFrame = cf
		return
	end
	if currentTween then currentTween:Cancel() end
	currentTween = TweenService:Create(root, TweenInfo.new(dist / cfg.Speed, Enum.EasingStyle.Linear), {CFrame = cf})
	currentTween:Play()
end

-- giữ nhân vật không rơi khi đang farm
local function setHover(on)
	local root = getHRP()
	if not root then return end
	local bv = root:FindFirstChild("XT_BV")
	if on and not bv then
		bv = Instance.new("BodyVelocity")
		bv.Name = "XT_BV"
		bv.Velocity = Vector3.zero
		bv.MaxForce = Vector3.new(1e9, 1e9, 1e9)
		bv.Parent = root
	elseif not on and bv then
		bv:Destroy()
	end
end

---------------------------------------------------------------- vòng lặp
-- Auto Farm
task.spawn(function()
	while task.wait(0.15) do
		if cfg.Farm then
			pcall(function()
				equipMelee()
				setHover(true)
				local mob = nearestEnemy()
				if mob then
					local part = mob.HumanoidRootPart
					local target = CFrame.lookAt(part.Position + Vector3.new(0, cfg.Height, 0), part.Position)
					flyTo(target)
				end
			end)
		else
			pcall(setHover, false)
		end
	end
end)

