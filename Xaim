local function bind(sig, fn) local c = sig:Connect(fn); conns[#conns + 1] = c; return c end
local function reg(fn) themed[#themed + 1] = fn; fn() end
local function applyAll() for _, f in ipairs(themed) do f() end end
local function new(class, props, parent)
	local o = Instance.new(class)
	for k, v in pairs(props) do o[k] = v end
	if parent then o.Parent = parent end
	return o
end
local function corner(o, r) return new("UICorner", {CornerRadius = typeof(r) == "UDim" and r or UDim.new(0, r or 8)}, o) end

