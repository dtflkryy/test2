local function toggle(page, text, key, cb)
	local row = rowFrame(page, 32)
	label(row, text)
	local sw = new("TextButton", {Text = "", AutoButtonColor = false, Size = UDim2.fromOffset(42, 22),
		AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -8, 0.5, 0), BorderSizePixel = 0}, row)
	corner(sw, UDim.new(1, 0))
	local knob = new("Frame", {Size = UDim2.fromOffset(16, 16), AnchorPoint = Vector2.new(0, 0.5),
		BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0}, sw)
	corner(knob, UDim.new(1, 0))
	local function paint() sw.BackgroundColor3 = S[key] and T.ac or Color3.fromRGB(90, 90, 100) end
	local function move(anim)
		local p = S[key] and UDim2.new(1, -19, 0.5, 0) or UDim2.new(0, 3, 0.5, 0)
		if anim then TweenService:Create(knob, TweenInfo.new(0.15), {Position = p}):Play() else knob.Position = p end
	end
	reg(paint); move(false)
	refreshers[key] = function() move(true); paint() end
	bind(sw.Activated, function()
		S[key] = not S[key]
		refreshers[key]()
		if cb then cb(S[key]) end
	end)
end

local activeSlider
local function slider(page, text, key, mn, mx, cb)
	local row = rowFrame(page, 48)
	label(row, text, {Position = UDim2.fromOffset(10, 4), Size = UDim2.new(1, -70, 0, 18)})
	local val = label(row, "", {Position = UDim2.new(1, -62, 0, 4), Size = UDim2.fromOffset(52, 18), TextXAlignment = Enum.TextXAlignment.Right})
	local hit = new("TextButton", {Text = "", BackgroundTransparency = 1, Position = UDim2.new(0, 10, 0, 24),
		Size = UDim2.new(1, -20, 0, 20), AutoButtonColor = false}, row)
	local track = new("Frame", {Position = UDim2.new(0, 0, 0.5, -3), Size = UDim2.new(1, 0, 0, 6),
		BackgroundColor3 = Color3.new(1, 1, 1), BackgroundTransparency = 0.7, BorderSizePixel = 0}, hit)
	corner(track, UDim.new(1, 0))
	local fill = new("Frame", {Size = UDim2.new(0, 0, 1, 0), BorderSizePixel = 0}, track)
	corner(fill, UDim.new(1, 0))
	local knob = new("Frame", {AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.fromOffset(14, 14),
		BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0}, track)
	corner(knob, UDim.new(1, 0))
	reg(function() fill.BackgroundColor3 = T.ac end)
	local function redraw()
		local r = (S[key] - mn) / (mx - mn)
		fill.Size = UDim2.new(r, 0, 1, 0)
		knob.Position = UDim2.new(r, 0, 0.5, 0)
		val.Text = tostring(math.floor(S[key] * 100 + 0.5) / 100)
	end
	local function upd(x)
		local r = math.clamp((x - hit.AbsolutePosition.X) / math.max(hit.AbsoluteSize.X, 1), 0, 1)
		local v = mn + (mx - mn) * r
		S[key] = (mx - mn) <= 2 and math.floor(v * 100 + 0.5) / 100 or math.floor(v + 0.5)
		redraw()
		if cb then cb(S[key]) end
	end
	redraw()
	bind(hit.InputBegan, function(i)
		if i.UserInputType == Enum.UserInputType.Touch or i.UserInputType == Enum.UserInputType.MouseButton1 then
			activeSlider = {input = i, upd = upd, page = page}
			page.ScrollingEnabled = false
			upd(i.Position.X)
		end
	end)
end

local function cycle(page, text, key, options, names)
	local row = rowFrame(page, 32)
	label(row, text)
	local b = new("TextButton", {AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -8, 0.5, 0),
		Size = UDim2.fromOffset(64, 22), Text = "", TextColor3 = Color3.new(1, 1, 1), Font = Enum.Font.GothamBold,
		TextSize = 12, AutoButtonColor = false, BorderSizePixel = 0}, row)
	corner(b, 8)
	reg(function() b.BackgroundColor3 = T.ac end)
	local function show() b.Text = names[S[key]] or tostring(S[key]) end
	show()
	bind(b.Activated, function()
		for i, o in ipairs(options) do
			if o == S[key] then S[key] = options[i % #options + 1]; break end
		end
		show()
	end)
end

local function swatches(page, title, items, getSel, onPick)
	local rows = math.ceil(#items / 7)
	local row = rowFrame(page, 26 + rows * 30)
	label(row, title, {Position = UDim2.fromOffset(10, 3), Size = UDim2.new(1, -20, 0, 18)})
	local grid = new("Frame", {BackgroundTransparency = 1, Position = UDim2.fromOffset(10, 24), Size = UDim2.new(1, -20, 0, rows * 30)}, row)
	new("UIGridLayout", {CellSize = UDim2.fromOffset(26, 26), CellPadding = UDim2.fromOffset(6, 4)}, grid)
	local strokes = {}
	local function mark()
		for i, s in ipairs(strokes) do s.Transparency = (i == getSel()) and 0 or 1 end
	end
	for i, it in ipairs(items) do
		local b = new("TextButton", {Text = it.rainbow and "RGB" or "", TextSize = 9, Font = Enum.Font.GothamBold,
			TextColor3 = Color3.new(1, 1, 1), AutoButtonColor = false, BorderSizePixel = 0,
			BackgroundColor3 = it.rainbow and Color3.new(1, 1, 1) or (it.c or it.ac)}, grid)
		corner(b, UDim.new(1, 0))
		if it.rainbow then
			new("UIGradient", {Color = ColorSequence.new({
				ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 70, 70)), ColorSequenceKeypoint.new(0.33, Color3.fromRGB(255, 230, 70)),
				ColorSequenceKeypoint.new(0.66, Color3.fromRGB(70, 200, 255)), ColorSequenceKeypoint.new(1, Color3.fromRGB(190, 90, 255))})}, b)
		end
		strokes[i] = new("UIStroke", {Color = Color3.new(1, 1, 1), Thickness = 2, Transparency = 1}, b)
		bind(b.Activated, function() onPick(i); mark() end)
	end
	mark()
end

