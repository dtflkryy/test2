end)

------------------------------------------------ esp
local esp = {}
local function espColor()
	local it = ESP_COLORS[S.ESPColor]
	if it.rainbow then return Color3.fromHSV((os.clock() * 0.3) % 1, 0.8, 1) end
	return it.c
end
local function getESP(plr)
	local e = esp[plr]
	if e then return e end
	local hl = new("Highlight", {FillTransparency = 1, OutlineTransparency = 0,
		DepthMode = Enum.HighlightDe
