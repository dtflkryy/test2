------------------------------------------------ aimbot logic
local rp = RaycastParams.new()
rp.FilterType = Enum.RaycastFilterType.Exclude

local function sameTeam(plr)
	if plr.Team and lp.Team then return plr.Team == lp.Team end
	return false
end
local function getPart(char)
	if S.Part == "Head" then return char:FindFirstChild("Head") end
	return char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso") or char:FindFirstChild("HumanoidRootPart")
end
local function visible(c, part, char)
	local ign = {lp.Character, char}
	local origin = c.CFrame.Position
	for _ = 1, 4 do
		rp.FilterDescendantsInstances = ign
		local r = workspace:Raycast(origin, part.Position - origin, rp)
		if not r then return true end
		local inst = r.Instance
		if inst.Transparency >= 0.95 or not inst.CanCollide then ign[#ign + 1] = inst else return false end
	end
	return false
end
local function getTarget(c)
	local best, bestD = nil, S.FOV
	local center = c.ViewportSize / 2
	for _, plr in ipairs(Players:GetPlayers()) do
		if plr ~= lp and not (S.TeamCheck and sameTeam(plr)) then
			local char = plr.Character
			local hum = char and char:FindFirstChildOfClass("Humanoid")
			local part = hum and hum.Health > 0 and getPart(char)
			if part then
				local pos, on = c:WorldToViewportPoint(part.Position)
				if on then
					local d = (Vector2.new(pos.X, pos.Y) - center).Magnitude
					if d < bestD and (part.Position - c.CFrame.Position).Magnitude <= S.AimMax
						and (not S.WallCheck or visible(c, part, char)) then
						best, bestD = part, d
					end
				end
			end
		end
	end
	return best
end

RunService:BindToRenderStep(BIND, Enum.RenderPriority.Camera.Value + 1, function()
	local c = workspace.CurrentCamera
	if not c then return end
	fov.Size = UDim2.fromOffset(S.FOV * 2, S.FOV * 2)
	fov.Visible = S.ShowFOV
	if not S.Aim then return end
	local part = getTarget(c)
	if part then
		local alpha = math.clamp(1 - S.Smooth / 100 * 0.96, 0.04, 1)
		c.CFrame = c.CFrame:Lerp(CFrame.lookAt(c.CFrame.Position, part.Position), alpha)
	end
end)

