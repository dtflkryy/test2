-- Slider bass
local BASS_MIN, BASS_MAX = -20, 10
local sliderHit = new("Frame", {Size = UDim2.fromOffset(260, 28), Position = UDim2.fromOffset(10, 178), BackgroundTransparency = 1, Active = true}, main)
local track_ = new("Frame", {Size = UDim2.new(1, 0, 0, 6), Position = UDim2.new(0, 0, 0.5, -3), BackgroundColor3 = PANEL, BorderSizePixel = 0}, sliderHit)
