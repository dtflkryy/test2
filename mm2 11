local gunLine = new("Frame", {
	Name = "GunLine", AnchorPoint = Vector2.new(0.5, 0.5), BackgroundColor3 = Color3.fromRGB(255, 230, 60),
	BorderSizePixel = 0, Visible = false, ZIndex = 20, Size = UDim2.fromOffset(0, 2),
}, gui)

local function clearGunESP()
	gunLine.Visible = false
	for _, d in ipairs(workspace:GetDescendants()) do
		if d.Name == "MM2GunESP" then d:Destroy() end
	end
end

local function updateGunESP()
	local g = findGun()
	if g and not g:FindFirstChild("MM2GunESP") then
		new("Highlight", {Name = "MM2GunESP", FillColor = Color3.fromRGB(255, 230, 60),
			OutlineColor = Color3.fromRGB(255, 255, 255), FillTransparency = 0.3,
			DepthMode = Enum.HighlightDepthMode.AlwaysOnTop, Adornee = g}, g)
	end
end

bind(RS.RenderStepped, function()
	updateESP()
	updateInfo()
	if state.gunesp then updateGunESP() end
	
	if not state.gunesp or not gun or not gun.Parent then
		gunLine.Visible = false
		return
	end
	local cam = workspace.CurrentCamera
	local vs = cam.ViewportSize
	local v = cam:WorldToViewportPoint(gun.Position)
	local ex, ey = v.X, v.Y
	if v.Z < 0 then
		ex, ey = vs.X - ex, vs.Y - ey
	end
	local sx, sy = vs.X / 2, 0
	local dx, dy = ex - sx, ey - sy
	local len = math.sqrt(dx * dx + dy * dy)
	gunLine.Size = UDim2.fromOffset(len, 2)
	gunLine.Position = UDim2.fromOffset(sx + dx / 2, sy + dy / 2)
	gunLine.Rotation = math.deg(math.atan2(dy, dx))
	gunLine.Visible = true
end)

local tping = false
local function tpGun(btn)
	if tping then return end
	local g = findGun()
	local root = hrp()
	if not g or not root then
		local old = btn.Text
		btn.Text = "Chưa có súng"
		task.delay(1.2, function() if btn.Parent then btn.Text = old end end)
		return
	end
	tping = true
	local back = root.CFrame
	root.CFrame = g.CFrame + Vector3.new(0, 2, 0)
	task.wait(2)
	root = hrp()
	if root then
		root.CFrame = back
		root.AssemblyLinearVelocity = Vector3.zero
	end
	tping = false
end

------------------------------------------------ Aimbot Murderer
local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Exclude
rayParams.IgnoreWater = true

local function aimStep()
	if not state.aim or not murderer then return end
	local mc, myc = murderer.Character, char()
	if not mc or not myc then return end
	local hm = mc:FindFirstChildOfClass("Humanoid")
	if not hm or hm.Health <= 0 then return end
	local tgt = mc:FindFirstChild("UpperTorso") or mc:FindFirstChild("Torso") or mc:FindFirstChild("HumanoidRootPart")
	if not tgt then return end
	local cam = workspace.CurrentCamera
	local origin = cam.CFrame.Position
	rayParams.FilterDescendantsInstances = {myc}
	local res = workspace:Raycast(origin, tgt.Position - origin, rayParams)
	if res and not res.Instance:IsDescendantOf(mc) then return end
	cam.CFrame = CFrame.lookAt(origin, tgt.Position)
end
RS:BindToRenderStep("MM2Aim", Enum.RenderPriority.Camera.Value + 1, aimStep)

------------------------------------------------ Shift Lock
local ugs
pcall(function() ugs = UserSettings():GetService("UserGameSettings") end)

local cursor = new("ImageLabel", {
	Name = "ShiftLockCursor", AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5),
	Size = UDim2.fromOffset(32, 32), BackgroundTransparency = 1,
	Image = "rbxasset://textures/MouseLockedCursor.png", Visible = false, ZIndex = 15,
}, gui)

local SHIFT_OFFSET = Vector3.new(1.75, 0, 0)

local function shiftStep()
	local h, root = hum(), hrp()
	if not h or not root then return end
	if state.shift then
		local cam = workspace.CurrentCamera
		local look = cam.CFrame.LookVector
		h.AutoRotate = false
		h.CameraOffset = h.CameraOffset:Lerp(SHIFT_OFFSET, 0.3)
		root.CFrame = CFrame.lookAt(root.Position, root.Position + Vector3.new(look.X, 0, look.Z))
		if UIS.MouseEnabled and not UIS.TouchEnabled then
			UIS.MouseBehavior = Enum.MouseBehavior.LockCenter
		end
	elseif h.CameraOffset.Magnitude > 0.01 then
		h.CameraOffset = h.CameraOffset:Lerp(Vector3.zero, 0.3)
	end
end
RS:BindToRenderStep("MM2Shift", Enum.RenderPriority.Character.Value + 1, shiftStep)

local function applyShift(v)
	state.shift = v
	cursor.Visible = v
	pcall(function()
		if ugs then ugs.RotationType = v and Enum.RotationType.CameraRelative or Enum.RotationType.MovementRelative end
	end)
	if not v then
		local h = hum()
		if h then h.AutoRotate = true end
		UIS.MouseBehavior = Enum.MouseBehavior.Default
	end
end

------------------------------------------------ Chống fling
local lastSafe
bind(RS.Stepped, function()
	if not state.antifling then return end
	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= lp and p.Character then
			for _, part in ipairs(p.Character:GetChildren()) do
				if part:IsA("BasePart") and part.CanCollide then part.CanCollide = false end
			end
		end
	end
	local root = hrp()
	if root then
		local lv, av = root.AssemblyLinearVelocity, root.AssemblyAngularVelocity
		if lv.Magnitude > 150 or av.Magnitude > 60 then
			root.AssemblyLinearVelocity = Vector3.zero
			root.AssemblyAngularVelocity = Vector3.zero
			if lastSafe then root.CFrame = lastSafe end
		else
			lastSafe = root.CFrame
		end
	end
end)

------------------------------------------------ TP Lobby / TP Map
local function tpTo(cf)
	local root = hrp()
	if not root then return false end
	root.CFrame = cf
	root.AssemblyLinearVelocity = Vector3.zero
	root.AssemblyAngularVelocity = Vector3.zero
	return true
end

local function spawnPoint(model)
	local parts = {}
	local sp = model:FindFirstChild("Spawns", true)
	if sp then
		for _, c in ipairs(sp:GetChildren()) do
			if c:IsA("BasePart") then table.insert(parts, c) end
		end
	end
	if #parts == 0 then
		for _, d in ipairs(model:GetDescendants()) do
			if d:IsA("SpawnLocation") or (d:IsA("BasePart") and d.Name == "Spawn") then
				table.insert(parts, d)
			end
		end
	end
	if #parts > 0 then
		return parts[math.random(#parts)].CFrame + Vector3.new(0, 4, 0)
	end
	local okp, cf = pcall(function() return model:GetPivot() end)
	if okp then return cf + Vector3.new(0, 6, 0) end
end

local function findMap()
	for _, m in ipairs(workspace:GetChildren()) do
		if m:IsA("Model") and m.Name ~= "Lobby" and not Players:GetPlayerFromCharacter(m)
			and (m:FindFirstChild("CoinContainer", true) or m:FindFirstChild("Spawns", true)) then
			return m
		end
	end
end

local function flash(btn, msg)
	local old = btn.Text
	btn.Text = msg
	task.delay(1.2, function() if btn.Parent then btn.Text = old end end)
end

local function tpLobby(btn)
	local lobby = workspace:FindFirstChild("Lobby")
	local cf = lobby and spawnPoint(lobby)
	if not cf or not tpTo(cf) then flash(btn, "Không thấy Lobby") end
end

local function tpMap(btn)
	local map = findMap()
	local cf = map and spawnPoint(map)
	if not cf or not tpTo(cf) then flash(btn, "Chưa có map") end
end

------------------------------------------------ TP Tool
local tpTool
local mouse = lp:GetMouse()

local function toolAlive()
	return tpTool and (tpTool:IsDescendantOf(lp) or (char() and tpTool:IsDescendantOf(char())))
end

local function ensureTool()
	if toolAlive() then return end
	local bp = lp:FindFirstChildOfClass("Backpack")
	if not bp then return end
	if tpTool then pcall(function() tpTool:Destroy() end) end
	tpTool = new("Tool", {Name = "TP Tool", RequiresHandle = false, CanBeDropped = false, ToolTip = "Chạm để dịch chuyển"})
	tpTool.Activated:Connect(function()
		local root = hrp()
		if root and mouse.Hit then
			local pos = mouse.Hit.Position + Vector3.new(0, 3, 0)
			root.CFrame = CFrame.new(pos) * (root.CFrame - root.CFrame.Position)
			root.AssemblyLinearVelocity = Vector3.zero
		end
	end)
	tpTool.Parent = bp
end

local function removeTool()
	if tpTool then pcall(function() tpTool:Destroy() end) end
	tpTool = nil
end

