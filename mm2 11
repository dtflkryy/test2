local state = {esp = false, gunesp = false, aim = false, shift = false, antifling = false, tptool = false}

local function char() return lp.Character end
local function hum() local c = char() return c and c:FindFirstChildOfClass("Humanoid") end
local function hrp() local c = char() return c and c:FindFirstChild("HumanoidRootPart") end

local function roleOf(p)
	local c = p.Character
	local bp = p:FindFirstChild("Backpack")
	local function has(n) return (c and c:FindFirstChild(n)) or (bp and bp:FindFirstChild(n)) end
	if has("Knife") then return "M" end
	if has("Gun") then return "S" end
	return "I"
end
local roleColor = {M = Color3.fromRGB(255, 50, 50), S = Color3.fromRGB(60, 140, 255), I = Color3.fromRGB(80, 255, 120)}

------------------------------------------------ ESP người
local function clearESP()
	for _, p in ipairs(Players:GetPlayers()) do
		local c = p.Character
		local h = c and c:FindFirstChild("MM2ESP")
		if h then h:Destroy() end
	end
end

local function updateESP()
	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= lp and p.Character then
			local h = p.Character:FindFirstChild("MM2ESP")
			if not h then
				h = new("Highlight", {Name = "MM2ESP", FillTransparency = 0.5, OutlineTransparency = 0,
					DepthMode = Enum.HighlightDepthMode.AlwaysOnTop}, p.Character)
			end
			local col = roleColor[roleOf(p)]
			h.FillColor = col
			h.OutlineColor = col
		end
	end
end

local murderer -- Player
local function updateInfo()
	local m, s = "?", "?"
	murderer = nil
	for _, p in ipairs(Players:GetPlayers()) do
		local r = roleOf(p)
		if r == "M" then
			m = p.Name
			if p ~= lp then murderer = p end
		elseif r == "S" then
			s = p.Name
		end
	end
	info.Text = "🔪 Murderer: " .. m .. "\n🔫 Sheriff: " .. s
end

