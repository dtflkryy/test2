---------------------------------------------------------------- helpers
local function hrp()
	local c = lp.Character
	return c and c:FindFirstChild("HumanoidRootPart")
end

local function humanoid()
	local c = lp.Character
	return c and c:FindFirstChildOfClass("Humanoid")
end

local function getLevel()
	local ok, v = pcall(function() return lp.Data.Level.Value end)
	return ok and v or 1
end

local CommF
local function remote()
	if not CommF then
		CommF = RS:WaitForChild("Remotes", 10):WaitForChild("CommF_", 10)
	end
	return CommF
end

local function pickEntry(level)
	local list = SEA and Q[SEA]
	if not list then return end
	local best = list[1]
	for _, e in ipairs(list) do
		if level >= e[1] then best = e else break end
	end
	return best
end

local function isAlive(m)
	local h = m:FindFirstChildOfClass("Humanoid")
	return h and h.Health > 0 and m:FindFirstChild("HumanoidRootPart") ~= nil
end

local function findMob(name)
	local root, folder = hrp(), workspace:FindFirstChild("Enemies")
	if not root or not folder then return end
	local best, bd
	for pass = 1, 2 do
		for _, m in ipairs(folder:GetChildren()) do
			local match = (pass == 1) and (m.Name == name) or (pass == 2 and m.Name:find(name, 1, true))
			if match and isAlive(m) then
				local d = (m.HumanoidRootPart.Position - root.Position).Magnitude
				if not bd or d < bd then best, bd = m, d end
			end
		end
		if best then break end
	end
	return best, bd
end

local function findSpawn(name)
	local root = hrp()
	local wo = workspace:FindFirstChild("_WorldOrigin")
	local folder = wo and wo:FindFirstChild("EnemySpawns")
	if not root or not folder then return end
	local best, bd
	for _, p in ipairs(folder:GetChildren()) do
		if p.Name == name or p.Name:find(name, 1, true) then
			local part = p:IsA("BasePart") and p or p:FindFirstChildWhichIsA("BasePart")
			if part then
				local d = (part.Position - root.Position).Magnitude
				if not bd or d < bd then best, bd = part, d end
			end
		end
	end
	return best
end

local function equipWeapon()
	local c, hum = lp.Character, humanoid()
	if not c or not hum then return end
	local want = TOOLTIP[cfg.Weapon] or "Melee"
	local cur = c:FindFirstChildOfClass("Tool")
	if cur and cur.ToolTip == want then return end
	for _, t in ipairs(lp.Backpack:GetChildren()) do
		if t:IsA("Tool") and t.ToolTip == want then
			hum:EquipTool(t)
			return
		end
	end
end

---------------------------------------------------------------- di chuyển
local tween, lastTarget

local function stopMove()
	if tween then tween:Cancel() tween = nil end
	lastTarget = nil
end

local function moveTo(cf)
	local root = hrp()
	if not root then return end
	local d = (root.Position - cf.Position).Magnitude
	if d <= 40 then
		stopMove()
		root.CFrame = cf
		return
	end
	-- chỉ tạo tween mới khi mục tiêu đổi đáng kể
	if tween and lastTarget and (lastTarget - cf.Position).Magnitude < 8 then return end
	if tween then tween:Cancel() end
	lastTarget = cf.Position
	tween = TweenService:Create(root, TweenInfo.new(d / cfg.Speed, Enum.EasingStyle.Linear), {CFrame = cf})
	tween:Play()
end

local function hover(on)
	local root = hrp()
	if not root then return end
	local bv = root:FindFirstChild("XT_BV")
	if on and not bv then
		bv = Instance.new("BodyVelocity")
		bv.Name = "XT_BV"
		bv.Velocity = Vector3.zero
		bv.MaxForce = Vector3.new(1e9, 1e9, 1e9)
		bv.Parent = root
	elseif not on and bv then
		bv:Destroy()
	end
end

local function cleanup()
	stopMove()
	pcall(hover, false)
end

---------------------------------------------------------------- quest
local lastQuestTry = 0

local function questGui()
	local pg = lp:FindFirstChild("PlayerGui")
	local main = pg and pg:FindFirstChild("Main")
	return main and main:FindFirstChild("Quest")
end

local function questMatches(mob)
	local q = questGui()
	if not (q and q.Visible) then return false end
	local ok, txt = pcall(function() return q.Container.QuestTitle.Title.Text end)
	return ok and type(txt) == "string" and txt:find(mob, 1, true) ~= nil
end

local function ensureQuest(e)
	if questMatches(e[2]) then return true end
	if os.clock() - lastQuestTry < 4 then return false end
	lastQuestTry = os.clock()
	local rem = remote()
	if not rem then return false end
	local q = questGui()
	if q and q.Visible then pcall(function() rem:InvokeServer("AbandonQuest") end) task.wait(0.4) end
	pcall(function() rem:InvokeServer("StartQuest", e[3], e[4]) end)
	task.wait(0.4)
	return questMatches(e[2])
end

---------------------------------------------------------------- trạng thái
local state = {text = "Đang tắt", mob = "-", quest = "-", fighting = false}
local wasFarming = false

local function step()
	if not cfg.Farm then
		if wasFarming then cleanup() wasFarming = false end
		state.text, state.fighting = "Đang tắt", false
		return
	end
	wasFarming = true

	if not SEA then state.text = "Sea không hỗ trợ (PlaceId lạ)" return end
	local root, hum = hrp(), humanoid()
	if not root or not hum or hum.Health <= 0 then
		state.text, state.fighting = "Chờ hồi sinh...", false
		return
	end

	local entry = pickEntry(getLevel())
	if not entry then return end
	state.mob = entry[2]

	hover(true)
	equipWeapon()

	if cfg.Quest then
		local ok = ensureQuest(entry)
		state.quest = ok and (entry[3] .. " #" .. entry[4]) or "chưa nhận được"
	else
		state.quest = "tắt"
	end

	local mob, dist = findMob(entry[2])
	if mob then
		local part = mob.HumanoidRootPart
		local pos = part.Position + Vector3.new(0, cfg.Height, 0)
		moveTo(CFrame.lookAt(pos, part.Position))
		state.fighting = dist ~= nil and dist < 60
		state.text = "Đánh " .. mob.Name
		return
	end

	state.fighting = false
	local sp = findSpawn(entry[2])
	if sp then
		moveTo(CFrame.new(sp.Position + Vector3.new(0, cfg.Height + 5, 0)))
		state.text = "Đi tới điểm spawn..."
	else
		state.text = "Không thấy quái / spawn"
	end
end

task.spawn(function()
	while running do
		task.wait(0.12)
		local ok, err = pcall(step)
		if not ok then state.text = "Lỗi: " .. tostring(err):sub(1, 40) end
	end
end)

