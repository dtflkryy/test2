local function addButton(text, order, color, cb)
	local b = new("TextButton", {
		Size = UDim2.new(1, -6, 0, 34), BackgroundColor3 = color or C.item, Text = text, TextColor3 = C.text,
		Font = Enum.Font.Gotham, TextSize = 13, AutoButtonColor = true, LayoutOrder = order,
	}, list)
	corner(b, 8)
	b.MouseButton1Click:Connect(function() cb(b) end)
	return b
end

function rebuild()
	for _, c in ipairs(list:GetChildren()) do
		if c:IsA("GuiButton") then c:Destroy() end
	end
	selectedBtn = nil
	local raw = search.Text
	local q = string.lower(raw)

	search.PlaceholderText = activeTab == "emote" and "Nhập tên emote (Enter = tìm online)" or "Tìm animation pack..."
	actionBtn.Text = activeTab == "emote" and "Dừng emote" or "Reset về animation gốc"

	tabAnim.BackgroundColor3 = activeTab == "anim" and C.accent or C.item
	tabAnim.TextColor3 = activeTab == "anim" and Color3.new(1, 1, 1) or C.sub
	tabEmote.BackgroundColor3 = activeTab == "emote" and C.accent or C.item
	tabEmote.TextColor3 = activeTab == "emote" and Color3.new(1, 1, 1) or C.sub

	if activeTab == "anim" then
		for i, d in ipairs(PACKS) do
			if q == "" or string.find(string.lower(d.name), q, 1, true) then
				local isCur = currentPack == d
				local b = addButton(d.name, i, isCur and C.accent or C.item, function(btn)
					if selectedBtn then selectedBtn.BackgroundColor3 = C.item end
					btn.BackgroundColor3 = C.accent
					selectedBtn = btn
					applyPack(d)
				end)
				if isCur then selectedBtn = b end
			end
		end
	else
		local order = 0
		local trimmed = raw:gsub("^%s+", ""):gsub("%s+$", "")
		if trimmed ~= "" then
			order += 1
			if trimmed:match("^%d+$") then
				addButton("▶ Phát ID " .. trimmed, order, C.accent, function()
					playEmote("ID " .. trimmed, tonumber(trimmed))
				end)
			else
				addButton("🌐 Tìm online: " .. trimmed, order, C.accent, function()
					onlineSearch(trimmed)
				end)
			end
		end
		for _, d in ipairs(EMOTES) do
			if q == "" or string.find(string.lower(d[1]), q, 1, true) then
				order += 1
				addButton(d[1], order, C.item, function() playEmote(d[1], d[2]) end)
			end
		end
		if q ~= "" and onlineFor == raw then
			for _, d in ipairs(onlineResults) do
				order += 1
				addButton("🌐 " .. d[1], order, C.item, function() playEmote(d[1], d[2]) end)
			end
		end
	end
end

