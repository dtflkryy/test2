local statusLabel
local function setStatus(t, ok)
	if statusLabel then
		statusLabel.Text = t
		statusLabel.TextColor3 = ok and Color3.fromRGB(110, 220, 140) or Color3.fromRGB(240, 120, 120)
	end
end

local function getChar()
	local c = lp.Character
	local h = c and c:FindFirstChildOfClass("Humanoid")
	return c, h
end

local currentPack = nil
local emoteTrack, emoteConn
local originalIds = nil -- animation gốc của người chơi (lưu khi spawn)

local function snapshotOriginal(char)
	local animate = char and char:FindFirstChild("Animate")
	if not animate then return end
	local snap = {}
	for _, s in ipairs(SLOTS) do
		local f = animate:FindFirstChild(s[1])
		local a = f and f:FindFirstChild(s[2])
		if a then snap[s[3]] = a.AnimationId end
	end
	originalIds = snap
end

local function refreshAnimate(hum, animate)
	animate.Disabled = true
	local animator = hum:FindFirstChildOfClass("Animator")
	if animator then
		for _, t in ipairs(animator:GetPlayingAnimationTracks()) do t:Stop() end
	end
	animate.Disabled = false
end

local function applyPack(pack, silent)
	local char, hum = getChar()
	local animate = char and char:FindFirstChild("Animate")
	if not (hum and animate) then
		setStatus("Không tìm thấy nhân vật / Animate", false)
		return
	end
	if not originalIds then snapshotOriginal(char) end
	for _, s in ipairs(SLOTS) do
		local id = pack[s[3]]
		if id then
			local f = animate:FindFirstChild(s[1])
			local a = f and f:FindFirstChild(s[2])
			if a then a.AnimationId = url(id) end
		end
	end
	refreshAnimate(hum, animate)
	currentPack = pack
	if not silent then setStatus("Đã áp dụng: " .. pack.name, true) end
end

local function resetToOriginal()
	local char, hum = getChar()
	local animate = char and char:FindFirstChild("Animate")
	if not (hum and animate) then
		return setStatus("Không tìm thấy nhân vật / Animate", false)
	end
	if not originalIds then
		return setStatus("Chưa có dữ liệu animation gốc", false)
	end
	for _, s in ipairs(SLOTS) do
		local id = originalIds[s[3]]
		if id then
			local f = animate:FindFirstChild(s[1])
			local a = f and f:FindFirstChild(s[2])
			if a then a.AnimationId = id end
		end
	end
	refreshAnimate(hum, animate)
	currentPack = nil
	setStatus("Đã reset về animation gốc của bạn", true)
end

local function stopEmote()
	if emoteConn then emoteConn:Disconnect() emoteConn = nil end
	if emoteTrack then emoteTrack:Stop() emoteTrack = nil end
end

local emoteToken = 0
local function playEmote(name, id)
	local _, hum = getChar()
	if not hum then return setStatus("Không tìm thấy Humanoid", false) end
	if hum.RigType ~= Enum.HumanoidRigType.R15 then
		return setStatus("Cần nhân vật R15", false)
	end
	local animator = hum:FindFirstChildOfClass("Animator") or Instance.new("Animator", hum)
	stopEmote()
	emoteToken += 1
	local myToken = emoteToken

	local anim = Instance.new("Animation")
	anim.AnimationId = url(id)
	local ok, track = pcall(function() return animator:LoadAnimation(anim) end)
	if not ok or not track then return setStatus("Không tải được emote", false) end

	setStatus("Đang tải: " .. name .. "...", true)
	local t0 = tick()
	repeat task.wait() until track.Length > 0 or tick() - t0 > 2
	if myToken ~= emoteToken then track:Destroy() return end
	if track.Length <= 0 then
		track:Destroy()
		return setStatus("ID không hợp lệ: " .. name, false)
	end

	track.Priority = Enum.AnimationPriority.Action
	track.Looped = true
	track:Play()
	emoteTrack = track
	setStatus("Đang chạy: " .. name .. " (di chuyển để dừng)", true)
	emoteConn = hum.Running:Connect(function(speed)
		if speed > 0.5 then stopEmote() setStatus("Đã dừng emote", true) end
	end)
end

-- Respawn: lưu animation gốc mới rồi áp dụng lại pack đang chọn
lp.CharacterAdded:Connect(function(char)
	stopEmote()
	local animate = char:WaitForChild("Animate", 10)
	char:WaitForChild("Humanoid", 10)
	if not animate then return end
	task.wait(0.3)
	snapshotOriginal(char)
	if currentPack then
		task.wait(0.2)
		applyPack(currentPack, true)
	end
end)
task.spawn(function()
	local c = lp.Character
	if c and c:WaitForChild("Animate", 10) then snapshotOriginal(c) end
end)

