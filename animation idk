local onlineResults, onlineFor = {}, ""

local function getRequest()
	return (syn and syn.request) or http_request or request or (fluxus and fluxus.request)
end

local rebuild -- khai báo trước

local function onlineSearch(q)
	local req = getRequest()
	if not req then return setStatus("Executor không hỗ trợ request", false) end
	setStatus("Đang tìm online: " .. q .. "...", true)
	task.spawn(function()
		local link = "https://catalog.roblox.com/v1/search/items/details?Keyword="
			.. HttpService:UrlEncode(q .. " emote") .. "&Limit=30"
		local ok, res = pcall(req, { Url = link, Method = "GET" })
		if not ok or not res or res.StatusCode ~= 200 then
			return setStatus("Tìm online thất bại", false)
		end
		local ok2, data = pcall(function() return HttpService:JSONDecode(res.Body) end)
		if not ok2 or type(data) ~= "table" then
			return setStatus("Dữ liệu trả về không hợp lệ", false)
		end
		local out = {}
		for _, it in ipairs(data.data or {}) do
			if it.assetType == 61 and it.id and it.name then
				table.insert(out, { it.name, it.id })
			end
		end
		onlineResults, onlineFor = out, q
		rebuild()
		setStatus(#out > 0 and ("Tìm thấy " .. #out .. " emote online") or "Không có kết quả online", #out > 0)
	end)
end

