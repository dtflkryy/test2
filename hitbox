local function new(class, props, kids)
    local o = Instance.new(class)
    for k, v in pairs(props or {}) do o[k] = v end
    for _, k in ipairs(kids or {}) do k.Parent = o end
    return o
end
local function corner(r) return new("UICorner", { CornerRadius = UDim.new(0, r) }) end

local Reg = {}
local function T(obj, prop, key)
    local e = { obj = obj, prop = prop, key = key }
    table.insert(Reg, e)
    obj[prop] = getColor(key)
    return e
end

local function refreshAll(tween)
    for i = #Reg, 1, -1 do
        local e = Reg[i]
        if not e.obj or not e.obj.Parent then
            table.remove(Reg, i)
        else
            local c = getColor(e.key)
            if tween and not (CurName == "Rainbow" and e.key == "accent") then
                TweenService:Create(e.obj, TweenInfo.new(0.35, Enum.EasingStyle.Quad), { [e.prop] = c }):Play()
            else
                e.obj[e.prop] = c
            end
        end
    end
end

bind(RunService.RenderStepped, function()
    if CurName == "Rainbow" then
        for _, e in ipairs(Reg) do
            if e.key == "accent" or type(e.key) == "function" then
                if e.obj.Parent then e.obj[e.prop] = getColor(e.key) end
            end
        end
    end
end)

local Locked = false

local function draggable(handle, target)
    local dragging, dragInput, startPos, startMouse
    local info = { moved = false }
    bind(handle.InputBegan, function(i)
        if Locked then return end
        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            info.moved = false
            startMouse = i.Position
            startPos = target.Position
            local c; c = i.Changed:Connect(function()
                if i.UserInputState == Enum.UserInputState.End then
                    dragging = false
                    c:Disconnect()
                end
            end)
        end
    end)
    bind(handle.InputChanged, function(i)
        if i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch then
            dragInput = i
        end
    end)
    bind(UIS.InputChanged, function(i)
        if dragging and i == dragInput and not Locked then
            local d = i.Position - startMouse
            if d.Magnitude > 6 then info.moved = true end
            TweenService:Create(target, TweenInfo.new(0.06, Enum.EasingStyle.Quad), {
                Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X, startPos.Y.Scale, startPos.Y.Offset + d.Y),
            }):Play()
        end
    end)
    return info
end

