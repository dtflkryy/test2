    local function set(v, silent)
        state = v
        TweenService:Create(knob, TweenInfo.new(0.2, Enum.EasingStyle.Back, Enum.EasingDirection.Out),
            { Position = v and UDim2.fromOffset(24, 2) or UDim2.fromOffset(2, 2) }):Play()
        TweenService:Create(track, TweenInfo.new(0.2),
            { BackgroundColor3 = v and getColor("accent") or getColor("off") }):Play()
        if not silent then cb(v) end
    end
    bind(track.Activated, function() set(not state) end)
    return set
end

local function Slider(page, text, min, max, default, step, cb)
    local r = row(page, 50)
    local lbl = label(r, text, UDim2.new(1, -70, 0, 24), UDim2.fromOffset(10, 2))
    local val = new("TextLabel", {
        Size = UDim2.fromOffset(60, 24), Position = UDim2.new(1, -70, 0, 2), BackgroundTransparency = 1,
        Font = Enum.Font.GothamBold, TextSize = 13, TextXAlignment = Enum.TextXAlignment.Right,
        Text = tostring(default), Parent = r,
    })
    T(val, "TextColor3", "accent")
    local bar = new("Frame", {
        Size = UDim2.new(1, -24, 0, 6), Position = UDim2.new(0, 12, 0, 34), BorderSizePixel = 0, Parent = r,
    }, { corner(3) })
    T(bar, "BackgroundColor3", "off")
    local fill = new("Frame", {
        Size = UDim2.fromScale((default - min) / (max - min), 1), BorderSizePixel = 0, Parent = bar,
    }, { corner(3) })
    T(fill, "BackgroundColor3", "accent")
    local knob = new("Frame", {
        Size = UDim2.fromOffset(14, 14), AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.fromScale((default - min) / (max - min), 0.5),
        BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0, Parent = bar,
    }, { corner(7) })

    local dragging = false
    local function update(x)
        local a = math.clamp((x - bar.AbsolutePosition.X) / bar.AbsoluteSize.X, 0, 1)
        local v = min + (max - min) * a
        v = math.floor(v / step + 0.5) * step
        v = math.clamp(v, min, max)
        local na = (v - min) / (max - min)
        fill.Size = UDim2.fromScale(na, 1)
        knob.Position = UDim2.fromScale(na, 0.5)
        val.Text = tostring(math.floor(v * 100 + 0.5) / 100)
        cb(v)
    end
    bind(bar.InputBegan, function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            page.ScrollingEnabled = false
            update(i.Position.X)
        end
    end)
    bind(UIS.InputChanged, function(i)
        if dragging and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
            update(i.Position.X)
        end
    end)
    bind(UIS.InputEnded, function(i)
        if dragging and (i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch) then
            dragging = false
            page.ScrollingEnabled = true
        end
    end)
end

