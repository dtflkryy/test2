local Orig = setmetatable({}, { __mode = "k" })
local FriendCache = {}

local function isFriend(p)
    if FriendCache[p] == nil then
        FriendCache[p] = false
        task.spawn(function()
            local ok, r = pcall(function() return LP:IsFriendsWith(p.UserId) end)
            FriendCache[p] = ok and r or false
        end)
    end
    return FriendCache[p]
end

local function restorePart(part)
    local o = Orig[part]
    if not o then return end
    pcall(function()
        part.Size = o.Size
        part.Transparency = o.Transparency
        part.CanCollide = o.CanCollide
        part.Massless = o.Massless
        part.Material = o.Material
        part.Color = o.Color
        if o.Shape then part.Shape = o.Shape end
    end)
    Orig[part] = nil
end

local function restoreAll()
    for part in pairs(Orig) do restorePart(part) end
end

local function applyPart(part, col)
    local o = Orig[part]
    if not o then
        o = {
            Size = part.Size, Transparency = part.Transparency, CanCollide = part.CanCollide,
            Massless = part.Massless, Material = part.Material, Color = part.Color,
        }
        pcall(function() o.Shape = part.Shape end)
        Orig[part] = o
    end
    pcall(function()
        part.Size = Vector3.new(S.Size, S.Size, S.Size)
        part.Transparency = S.Transparency
        part.CanCollide = false
        part.Massless = true
        part.Color = col
        part.Material = S.Neon and Enum.Material.Neon or Enum.Material.Plastic
        part.Shape = (S.Shape == "Ball") and Enum.PartType.Ball or Enum.PartType.Block
    end)
end

bind(RunService.Heartbeat, function(dt)
    hue = (hue + dt * 0.25) % 1
    if not S.Enabled then return end

    local opt = ColorOpts[S.ColorIdx]
    local col = opt.rainbow and Color3.fromHSV(hue, 1, 1) or opt.c
    local myRoot = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")

    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LP then
            local ch = p.Character
            local part = ch and ch:FindFirstChild(S.Part)
            if part and part:IsA("BasePart") then
                local hum = ch:FindFirstChildOfClass("Humanoid")
                local skip = (not hum) or hum.Health <= 0
                    or (S.TeamCheck and p.Team ~= nil and p.Team == LP.Team)
                    or (S.IgnoreFriends and isFriend(p))
                    or (S.MaxDist > 0 and myRoot and (part.Position - myRoot.Position).Magnitude > S.MaxDist)
                if skip then restorePart(part) else applyPart(part, col) end
            end
        end
    end
end)

