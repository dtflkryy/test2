local function addToggle(text, key, onChange)
	local b = new("TextButton", {
		Size = UDim2.new(1, -4, 0, 32),
		BackgroundColor3 = Cfg[key] and ACCENT or OFFC,
		Text = text .. ": " .. (Cfg[key] and "BẬT" or "TẮT"),
		TextSize = 16,
		Font = FONT,
		TextColor3 = Color3.new(1, 1, 1),
		ZIndex = 6,
	}, Body)
	corner(b, 6)
	b.Activated:Connect(function()
		Cfg[key] = not Cfg[key]
		b.Text = text .. ": " .. (Cfg[key] and "BẬT" or "TẮT")
		b.BackgroundColor3 = Cfg[key] and ACCENT or OFFC
		if onChange then onChange(Cfg[key]) end
	end)
end

local function addStepper(text, key, min, max, step, fmt, onChange)
	local row = new("Frame", {
		Size = UDim2.new(1, -4, 0, 32),
		BackgroundColor3 = PANEL,
		ZIndex = 6,
	}, Body)
	corner(row, 6)
	local label = new("TextLabel", {
		Size = UDim2.new(1, -72, 1, 0),
		Position = UDim2.fromOffset(8, 0),
		BackgroundTransparency = 1,
		TextSize = 15,
		Font = FONT,
		TextColor3 = Color3.new(1, 1, 1),
		TextXAlignment = Enum.TextXAlignment.Left,
		ZIndex = 7,
	}, row)
	local function refresh() label.Text = text .. ": " .. string.format(fmt, Cfg[key]) end
	refresh()
	local function btn(txt, xoff, delta)
		local b = new("TextButton", {
			Size = UDim2.fromOffset(28, 24),
			Position = UDim2.new(1, xoff, 0, 4),
			BackgroundColor3 = OFFC,
			Text = txt,
			TextSize = 18,
			Font = FONT,
			TextColor3 = Color3.new(1, 1, 1),
			ZIndex = 7,
		}, row)
		corner(b, 6)
		b.Activated:Connect(function()
			Cfg[key] = math.clamp(math.floor((Cfg[key] + delta) / step + 0.5) * step, min, max)
			refresh()
			if onChange then onChange(Cfg[key]) end
		end)
	end
	btn("-", -66, -step)
	btn("+", -34, step)
end

local function addCycle(text, key, list)
	local b = new("TextButton", {
		Size = UDim2.new(1, -4, 0, 32),
		BackgroundColor3 = PANEL,
		Text = text .. ": " .. list[Cfg[key]],
		TextSize = 16,
		Font = FONT,
		TextColor3 = Color3.new(1, 1, 1),
		ZIndex = 6,
	}, Body)
	corner(b, 6)
	b.Activated:Connect(function()
		Cfg[key] = Cfg[key] % #list + 1
		b.Text = text .. ": " .. list[Cfg[key]]
	end)
end

