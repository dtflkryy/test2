--------------------------------------------------
-- Logic aimbot
--------------------------------------------------
local function getAimPart(char)
	local name = Parts[Cfg.PartIdx]
	if name == "Torso" then
		return char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso")
	end
	return char:FindFirstChild(name)
end

local function isVisible(part, char)
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { LP.Character, char, Cam }
	params.IgnoreWater = true
	local origin = Cam.CFrame.Position
	local result = Workspace:Raycast(origin, part.Position - origin, params)
	return result == nil
end

local function getTarget()
	local center = Cam.ViewportSize / 2
	local best, bestScore = nil, math.huge
	local myRoot = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")

	for _, plr in ipairs(Players:GetPlayers()) do
		if plr ~= LP and plr.Character then
			local char = plr.Character
			local hum = char:FindFirstChildOfClass("Humanoid")
			local part = getAimPart(char)
			if hum and hum.Health > 0 and part then
				if not (Cfg.TeamCheck and plr.Team ~= nil and plr.Team == LP.Team) then
					local pos, onScreen = Cam:WorldToViewportPoint(part.Position)
					if onScreen then
						local screenDist = (Vector2.new(pos.X, pos.Y) - center).Magnitude
						if screenDist <= Cfg.FOV then
							if not Cfg.WallCheck or isVisible(part, char) then
								local score = screenDist
								if Cfg.PriorityIdx == 2 and myRoot then
									score = (myRoot.Position - part.Position).Magnitude
								end
								if score < bestScore then
									bestScore, best = score, part
								end
							end
						end
					end
				end
			end
		end
	end
	return best
end

local conn = RunService.RenderStepped:Connect(function()
	Cam = Workspace.CurrentCamera
	if not Cfg.Aimbot or not Cam then return end
	local part = getTarget()
	if not part then return end

	local aimPos = part.Position
	if Cfg.Predict then
		aimPos = aimPos + part.AssemblyLinearVelocity * Cfg.PredictStr
	end
	local goal = CFrame.new(Cam.CFrame.Position, aimPos)
	Cam.CFrame = Cam.CFrame:Lerp(goal, 1 / math.max(Cfg.Smooth, 1))
end)

Gui.Destroying:Connect(function() conn:Disconnect() end)
